<Window x:Class="JamalLife.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2"
        Title="Jamal Life" Icon="app.ico" Background="#08121E"
        WindowStartupLocation="CenterScreen" Width="1360" Height="900" MinWidth="920" MinHeight="640">
  <Grid>
    <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#08121E"/>
    <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="White" FontSize="16" TextWrapping="Wrap"
               Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
  </Grid>
</Window>
